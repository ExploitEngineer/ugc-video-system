# ─────────────────────────────────────────────────────────────
# web — PUBLIC vars only. Anything here with the NEXT_PUBLIC_
# prefix is inlined into the browser bundle, so it must be safe
# to expose. NEVER put server secrets (service-role key, OpenAI,
# fal, DATABASE_URL) here. Copy to `apps/web/.env.local`.
# ─────────────────────────────────────────────────────────────

# Base URL of the Hono api
NEXT_PUBLIC_API_URL=http://localhost:3001

# img.ly CE.SDK license key for the in-browser video editor. Get a free trial
# key at https://img.ly/forms/free-trial. Without it the editor still works but
# burns a watermark into exported videos. Client-side by design (it is a browser
# license key, not a secret).
NEXT_PUBLIC_CESDK_LICENSE=
