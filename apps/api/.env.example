# ─────────────────────────────────────────────────────────────
# api — SERVER-ONLY secrets. Loaded + Zod-validated in src/config.
# Copy to `apps/api/.env` and fill in. Never commit the real .env.
# NONE of these may ever be exposed to the browser / web bundle.
# ─────────────────────────────────────────────────────────────

# OpenAI — GPT Image 2 (image artifacts) + LLM reasoning/critique
OPENAI_API_KEY=

# BytePlus ModelArk — Seedance 2.0 video generation (sole video provider, F6).
BYTEPLUS_API_KEY=

# Video provider tuning (optional — sensible defaults in src/config).
# BYTEPLUS_BASE_URL: BytePlus ModelArk API root (e.g. ap-southeast region).
# BYTEPLUS_VIDEO_MODEL: Seedance 2.0 model slug.
# BYTEPLUS_POLL_INTERVAL_MS: poll cadence in ms.
# BYTEPLUS_BASE_URL=https://ark.ap-southeast.bytepluses.com
# BYTEPLUS_VIDEO_MODEL=dreamina-seedance-2-0-260128
# BYTEPLUS_POLL_INTERVAL_MS=5000
# BYTEPLUS_POLL_TIMEOUT_MS=600000

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string for Drizzle / migrations
DATABASE_URL=

# F7 background worker — in-process loop that advances runs through the pipeline.
# WORKER_ENABLED: `true` (default) | `false` (passive HTTP server, e.g. for tests).
# WORKER_POLL_INTERVAL_MS: how often the loop polls `runs` for claimable work.
# WORKER_ENABLED=true
# WORKER_POLL_INTERVAL_MS=1500
