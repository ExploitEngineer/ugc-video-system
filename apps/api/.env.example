# ─────────────────────────────────────────────────────────────
# api — SERVER-ONLY secrets. Loaded + Zod-validated in src/config.
# Copy to `apps/api/.env` and fill in. Never commit the real .env.
# NONE of these may ever be exposed to the browser / web bundle.
# ─────────────────────────────────────────────────────────────

# OpenAI — GPT Image 2 (image artifacts) + LLM reasoning/critique
OPENAI_API_KEY=

# Volcengine / BytePlus Ark — Seedance 2.0 video generation (key starts `ark-`)
ARK_API_KEY=

# Video generation provider + tuning (F6).
# VIDEO_PROVIDER: `ark` (default, SPEC-canonical) | `runcomfy` (fallback CLI adapter).
# ARK_BASE_URL: Volcengine `https://ark.cn-beijing.volces.com` or
#               BytePlus `https://ark.ap-southeast.bytepluses.com`.
# ARK_VIDEO_MODEL: Seedance 2.0 slug (Volcengine `doubao-seedance-2-0-260128`,
#               BytePlus `dreamina-seedance-2-0-260128`).
# VIDEO_PROVIDER=ark
# ARK_BASE_URL=https://ark.cn-beijing.volces.com
# ARK_VIDEO_MODEL=doubao-seedance-2-0-260128
# ARK_POLL_INTERVAL_MS=5000
# ARK_POLL_TIMEOUT_MS=600000
# RUNCOMFY_TOKEN=        # only when VIDEO_PROVIDER=runcomfy

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string for Drizzle / migrations
DATABASE_URL=

# F7 background worker — in-process loop that advances runs through the pipeline.
# WORKER_ENABLED: `true` (default) | `false` (passive HTTP server, e.g. for tests).
# WORKER_POLL_INTERVAL_MS: how often the loop polls `runs` for claimable work.
# WORKER_ENABLED=true
# WORKER_POLL_INTERVAL_MS=1500
