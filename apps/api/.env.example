# ─────────────────────────────────────────────────────────────
# api — SERVER-ONLY secrets. Loaded + Zod-validated in src/config.
# Copy to `apps/api/.env` and fill in. Never commit the real .env.
# NONE of these may ever be exposed to the browser / web bundle.
# ─────────────────────────────────────────────────────────────

# OpenAI — GPT Image 2 (image artifacts) + LLM reasoning/critique
OPENAI_API_KEY=

# OpenRouter — Claude Sonnet 4.6 is the DEFAULT reasoning/vision backend for
# every chat() call (image gen stays gpt-image-2). OpenAI-SDK-compatible.
# OPTIONAL: leave blank and all reasoning/vision falls back to gpt-4.1.
# Key form: sk-or-v1-...
OPENROUTER_API_KEY=

# Reasoning/vision model ids — optional per-deploy overrides (sensible defaults
# in src/config). Verify any slug is live via GET https://openrouter.ai/api/v1/models.
#   OPENAI_CHAT_MODEL      the gpt-4.1 fallback, and what BOTH OpenRouter backends
#                          degrade to when OPENROUTER_API_KEY is unset
#   OPENROUTER_CLAUDE_MODEL the default reasoning/vision slug
#   OPENROUTER_SMALL_MODEL  the `backend: "small"` slug — short, mechanical, high
#                          volume calls (the template plan and its on-screen copy)
#                          where the big model's judgement buys nothing
# OPENAI_CHAT_MODEL=gpt-4.1
# OPENROUTER_CLAUDE_MODEL=anthropic/claude-sonnet-4.6
# OPENROUTER_SMALL_MODEL=anthropic/claude-haiku-4.5

# BytePlus ModelArk — Seedance 2.0 video generation (sole video provider, F6).
# This `ark-...` key authenticates VIDEO GENERATION (inference) ONLY.
BYTEPLUS_API_KEY=

# Video provider tuning (optional — sensible defaults in src/config).
# BYTEPLUS_BASE_URL: BytePlus ModelArk API root (e.g. ap-southeast region).
# BYTEPLUS_VIDEO_MODEL: Seedance 2.0 model slug.
# BYTEPLUS_VIDEO_RESOLUTION: output resolution (480p | 720p | 1080p). Default
#   1080p — reads as real phone footage; drop to 720p to cut cost/render time.
# BYTEPLUS_POLL_INTERVAL_MS: poll cadence in ms.
# BYTEPLUS_POLL_TIMEOUT_MS: max wall-clock wait per clip before a run fails
#   (default 1800000 = 30 min). 1080p Seedance can render >10 min, so a lower
#   value false-fails legitimately slow clips.
# BYTEPLUS_BASE_URL=https://ark.ap-southeast.bytepluses.com
# BYTEPLUS_VIDEO_MODEL=dreamina-seedance-2-0-260128
# BYTEPLUS_VIDEO_RESOLUTION=1080p
# BYTEPLUS_POLL_INTERVAL_MS=5000
# BYTEPLUS_POLL_TIMEOUT_MS=1800000

# BytePlus asset management — register real-human/face images so Seedance's
# face filter accepts them (see docs/byteplus-face-assets.md). SEPARATE from the
# `ark-` key above: this uses an Access Key + Secret Key (AK/SK) from the
# BytePlus console. Leave blank to run without face registration (the flow then
# sends faces as raw URLs, which the filter may reject). Add these later.
BYTEPLUS_ACCESS_KEY=
BYTEPLUS_SECRET_KEY=
# BYTEPLUS_REGION=ap-southeast-1
# Reuse ONE asset group across runs — auto-created + logged once if unset.
# BYTEPLUS_ASSET_GROUP_ID=
# Asset-management OpenAPI (verified defaults — override only if BytePlus changes them):
# BYTEPLUS_OPENAPI_HOST=open.byteplusapi.com
# BYTEPLUS_ASSET_SERVICE=ark
# BYTEPLUS_ASSET_API_VERSION=2024-01-01

# ── Template library pipeline (After Effects rendering via Nexrender Cloud) ──
# An admin curates a library of .aep/.zip templates; a user picks one, writes an
# ad brief, and the agents write the copy, generate the images and produce a clip
# as long as the template's own composition. Cloud is the only viable host — AE
# has no Linux build, so self-hosting is impossible on this stack.

# Shared secret for the /admin/* routes (template upload + management), sent as
# an `x-admin-key` header. A SOFT GUARD, not real auth: it stops a stranger who
# finds the URL from uploading a 200MB .aep and burning Nexrender credits. It is
# replaced wholesale by Supabase RBAC when F8 lands.
# Unset it and the admin routes return 503 in EVERY environment — they never
# default open, because a misread NODE_ENV in a deploy must not expose upload.
# Minimum 16 characters. Generate one with: openssl rand -hex 24
ADMIN_API_KEY=

# Master switch for the template pipeline. OFF by default: `POST /runs` rejects
# `pipeline: "template"` until it has been smoke-tested end to end.
# TEMPLATE_STEP_ENABLED=false

# Files bigger than this are NOT uploaded to Supabase Storage — the hosted project
# rejects an object over its global cap (~50MB by default, raisable only on a paid
# plan). A render past this is kept at its provider URL (the ~14d Nexrender output)
# so a big video is still viewable. Raise this once you raise the Supabase limit.
# STORAGE_UPLOAD_MAX_BYTES=52428800   # 50 * 1024 * 1024

# Template analysis (the `template_plan` step SEES the template).
#   claude (default) = Claude Sonnet vision over the preview poster + sampled frames (stills).
#   gemini           = Gemini WATCHES the rendered preview clip end-to-end for real
#                      motion/timing. Takes effect ONLY with a live GEMINI_API_KEY;
#                      any failure (missing key, dead preview URL) degrades to Claude.
# TEMPLATE_VISION_PROVIDER=claude
# GEMINI_API_KEY=
# GEMINI_VISION_MODEL=gemini-2.5-pro   # any video-capable Gemini slug; flash = cheaper/faster
# TEMPLATE_VISION_FRAME_COUNT=12       # frames for the Claude still pass (0 = poster only)

# Leave NEXRENDER_API_KEY blank (or set NEXRENDER_STUB=true) to use a STUB
# renderer that echoes the input clip back as the render. The whole admin →
# introspect → pick → render flow then works with no Nexrender account and no
# credits, which is how the free smoke test runs.
NEXRENDER_API_KEY=
# NEXRENDER_STUB=false            # force the stub even when a key is set
# NEXRENDER_BASE_URL=https://api.nexrender.com
# NEXRENDER_POLL_INTERVAL_MS=5000
# NEXRENDER_POLL_TIMEOUT_MS=1800000

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string for Drizzle / migrations.
# LOCAL DEV: use the bundled Postgres (`docker compose up -d`) so local runs stay
# off prod — pointing this at the prod Supabase DB makes the prod worker process
# your local runs (double-logging, wasted credits).
#   local: postgresql://postgres:postgres@localhost:5432/ugc
# PROD: inject the Supabase pooler URL via the deployment env, not this file.
DATABASE_URL=

# F7 background worker — in-process loop that advances runs through the pipeline.
# WORKER_ENABLED: `true` (default) | `false` (passive HTTP server, e.g. for tests).
# WORKER_POLL_INTERVAL_MS: how often the loop polls `runs` for claimable work.
# WORKER_INHIBIT_SLEEP: hold an OS sleep inhibitor while a run is in flight
#   (default `true`; needs systemd, a silent no-op elsewhere). A run is ~20min of
#   waiting on providers, which a laptop's idle timer reads as an idle machine —
#   and a suspend mid-run kills the worker's sockets and can fail a paid run.
# WORKER_ENABLED=true
# WORKER_POLL_INTERVAL_MS=1500
# WORKER_INHIBIT_SLEEP=true

# Large-media downloads (AE renders, Seedance clips, masters). Governed by a
# WALL-CLOCK stall timeout — abort only after this long with NO received bytes —
# never a total-duration cap, so a healthy slow 100MB+ transfer is never killed.
# MEDIA_DOWNLOAD_IDLE_TIMEOUT_MS: silence budget before an attempt is abandoned.
# MEDIA_DOWNLOAD_MAX_MS: absolute backstop for one attempt (the stall timer is
#   the real guard).
# MEDIA_DOWNLOAD_ATTEMPTS: whole-download attempts, each on a FRESH connection,
#   with a seconds-scale backoff — a stall is usually a network transition that
#   outlives a couple of fast retries.
# MEDIA_DOWNLOAD_IDLE_TIMEOUT_MS=120000
# MEDIA_DOWNLOAD_MAX_MS=1800000
# MEDIA_DOWNLOAD_ATTEMPTS=5
